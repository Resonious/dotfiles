#!/bin/sh

# Container name based on current directory
JAIL_NAME="jail-$(basename "$PWD")"
PROJECT_NAME="$(basename "$PWD")"

cmd="${1:-run}"
shift 2>/dev/null || true

case "$cmd" in
    exec)
        exec podman exec -it -u dev -w "/home/dev/$PROJECT_NAME" "$JAIL_NAME" fish
        ;;
    home)
        # Mount current directory as home directory
        podman run -it --rm \
            --userns=keep-id \
            --name "$JAIL_NAME" \
            -v .:/home/dev:Z \
            -v jail-claude-home:/home/dev/.claude \
            -v jail-claude-bin:/home/dev/.local/bin \
            -v jail-cargo-registry:/usr/local/cargo/registry \
            -v jail-npm-user:/home/dev/.npm-global \
            -v jail-gem-home:/home/dev/.gem \
            -e GIT_AUTHOR_NAME="Nigel Baillie" \
            -e GIT_COMMITTER_NAME="Nigel Baillie" \
            -e GIT_AUTHOR_EMAIL="nigel@baillie.dev" \
            -e GIT_COMMITTER_EMAIL="nigel@baillie.dev" \
            -e COLORTERM=truecolor \
            -w /home/dev \
            "$@" \
            jail
        ;;
    run)
        podman run -it --rm \
            --userns=keep-id \
            --name "$JAIL_NAME" \
            -v ".:/home/dev/$PROJECT_NAME:Z" \
            -v jail-claude-home:/home/dev/.claude \
            -v jail-claude-bin:/home/dev/.local/bin \
            -v jail-cargo-registry:/usr/local/cargo/registry \
            -v jail-npm-user:/home/dev/.npm-global \
            -v jail-gem-home:/home/dev/.gem \
            -e GIT_AUTHOR_NAME="Nigel Baillie" \
            -e GIT_COMMITTER_NAME="Nigel Baillie" \
            -e GIT_AUTHOR_EMAIL="nigel@baillie.dev" \
            -e GIT_COMMITTER_EMAIL="nigel@baillie.dev" \
            -e COLORTERM=truecolor \
            -w "/home/dev/$PROJECT_NAME" \
            "$@" \
            jail
        ;;
    *)
        echo "Usage: jail [run|home|exec]"
        exit 1
        ;;
esac
